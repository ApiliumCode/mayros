{
  "id": "kakeru-bridge",
  "kind": "coordination",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "codex": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "binaryPath": { "type": "string", "default": "codex" },
          "apiKeyEnv": { "type": "string", "default": "OPENAI_API_KEY" },
          "defaultTimeout": { "type": "integer", "default": 300000 }
        }
      },
      "branchPrefix": { "type": "string", "default": "kakeru" },
      "autoMerge": { "type": "boolean", "default": false }
    }
  }
}
