{
  "name": "@apilium/mayros-nostr",
  "version": "0.4.0",
  "description": "Mayros Nostr channel plugin for NIP-04 encrypted DMs",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "nostr-tools": "^2.23.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@apilium/mayros": ">=0.1.0"
  },
  "mayros": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "nostr",
      "label": "Nostr",
      "selectionLabel": "Nostr (NIP-04 DMs)",
      "docsPath": "/channels/nostr",
      "docsLabel": "nostr",
      "blurb": "Decentralized protocol; encrypted DMs via NIP-04.",
      "order": 55,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@apilium/mayros-nostr",
      "localPath": "extensions/nostr",
      "defaultChoice": "npm"
    }
  }
}
