{
  "name": "@apilium/mayros-msteams",
  "version": "0.3.2",
  "description": "Mayros Microsoft Teams channel plugin",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@microsoft/agents-hosting": "^1.3.1",
    "express": "^5.2.1"
  },
  "peerDependencies": {
    "@apilium/mayros": ">=0.1.0"
  },
  "mayros": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "msteams",
      "label": "Microsoft Teams",
      "selectionLabel": "Microsoft Teams (Bot Framework)",
      "docsPath": "/channels/msteams",
      "docsLabel": "msteams",
      "blurb": "Bot Framework; enterprise support.",
      "aliases": [
        "teams"
      ],
      "order": 60
    },
    "install": {
      "npmSpec": "@apilium/mayros-msteams",
      "localPath": "extensions/msteams",
      "defaultChoice": "npm"
    }
  }
}
