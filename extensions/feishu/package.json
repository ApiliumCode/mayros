{
  "name": "@apilium/mayros-feishu",
  "version": "0.2.0",
  "description": "Mayros Feishu/Lark channel plugin (community maintained by @m1heng)",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@sinclair/typebox": "0.34.48",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@apilium/mayros": ">=0.1.0"
  },
  "mayros": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "feishu",
      "label": "Feishu",
      "selectionLabel": "Feishu/Lark (\u98de\u4e66)",
      "docsPath": "/channels/feishu",
      "docsLabel": "feishu",
      "blurb": "\u98de\u4e66/Lark enterprise messaging with doc/wiki/drive tools.",
      "aliases": [
        "lark"
      ],
      "order": 35,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@apilium/mayros-feishu",
      "localPath": "extensions/feishu",
      "defaultChoice": "npm"
    }
  }
}
