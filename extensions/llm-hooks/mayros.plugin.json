{
  "id": "llm-hooks",
  "kind": "security",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "projectHooksDir": { "type": "string" },
      "userHooksDir": { "type": "string" },
      "defaultModel": { "type": "string" },
      "defaultTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
      "defaultCache": { "type": "string", "enum": ["none", "session", "global"] },
      "maxConcurrentEvals": { "type": "integer", "minimum": 1, "maximum": 10 },
      "globalCacheTtlMs": { "type": "integer", "minimum": 10000 }
    }
  }
}
